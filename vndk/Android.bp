cc_prebuilt_library_shared {
    name: "libssl-v33",
    vendor: true,
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["libssl-v33.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
}

