android_app_import {
	name: "ShadeProvider.tran",
	owner: "infinix",
	apk: "shadeprovider.apk",
	certificate: "platform",
	dex_preopt: {
		enabled: false,
	},
	privileged: true,
	system_ext_specific: true,

    required: [
        "privapp_whitelist_shadeprovider",
        "config-shadeprovider",
    ],
}


prebuilt_etc {
    name: "privapp_whitelist_shadeprovider",
    relative_install_path: "permissions",
    src: "privapp_whitelist_shadeprovider.xml",
    system_ext_specific: true,
    filename_from_src: true,
}

prebuilt_etc {
    name: "config-shadeprovider",
    relative_install_path: "sysconfig",
    src: "shadeprovider-whitelist.xml",
    system_ext_specific: true,
    filename_from_src: true,
}